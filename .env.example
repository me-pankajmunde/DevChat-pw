# Supabase Configuration for DevChat Local
# ==========================================
# These environment variables enable cloud sync for your chats

# Your Supabase Project URL (already configured)
VITE_SUPABASE_URL=https://cgwmhcmioxxteajbtsdd.supabase.co

# Your Supabase Anon/Public Key (get from Supabase Dashboard)
# Go to: https://supabase.com/dashboard/project/cgwmhcmioxxteajbtsdd/settings/api
# Copy the "anon public" key and paste it below
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 📖 Quick Setup Instructions:
# 1. Copy this file to .env (same directory)
# 2. Get your anon key from Supabase Dashboard > Settings > API
# 3. Replace "your-anon-key-here" with your actual anon key
# 4. Save the file
# 5. Restart the application
# 
# ⚠️ Security Notes:
# - Use the "anon public" key (safe for client-side)
# - NEVER use the "service_role" key here!
# - Don't commit your actual .env file to git
#
# 📚 For detailed setup, see QUICK_SETUP.md
